{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "dependencyDashboard": true,
  "git-submodules": {
    "enabled": true
  },
  "tekton": {
    "enabled": true,
    "automergeType": "pr",
    "automerge": true,
    "platformAutomerge": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "groupName": "All Python Dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ],
  "customManagers": [
    {
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "customType": "regex",
      "description": "Update dependency versions in the Dockerfile",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+?)\\s"
      ]
    },
    {
      "managerFilePatterns": [
        "/^\\.github/workflows\\/.*\\.ya?ml$/"
      ],
      "customType": "regex",
      "description": "Update tool versions in GitHub Actions workflows",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s+ACTIONLINT_VERSION: (?<currentValue>\\S+)"
      ]
    }
  ]
}
